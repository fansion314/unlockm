{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UnlockM",
  "version": "0.2.1",
  "identifier": "world.fansionia.unlockm",
  "build": {
    "beforeDevCommand": "vp dev --host 127.0.0.1",
    "beforeBuildCommand": "vp build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UnlockM",
        "width": 1080,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' blob: data:; media-src 'self' unlockm-audio: http://unlockm-audio.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "copyright": "Copyright © Hamlet Fansion (Peilin Fan)",
    "active": true,
    "targets": ["dmg", "nsis"],
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../third_party/licenses/SIL-OFL-1.1.txt": "licenses/SIL-OFL-1.1.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
